{
  "name": "rangara-paint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Persian RTL marketing and product discovery website for an architectural paint manufacturer",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
